mdp

// A small acyclic MDP for distributional reward-reachability experiments.
// Risk-neutral minimization prefers action [fast] at s=0:
//   0.85 * 2 + 0.15 * 30 = 6.2
// over the safer action [safe]:
//   0.5 * 6 + 0.5 * 7 = 6.5
// CVaR minimization with a small tail mass prefers [safe], because [fast]
// exposes the upper-tail cost 30.

module distributional_choice
    s : [0..6] init 0;

    [fast] s=0 -> 0.85 : (s'=1) + 0.15 : (s'=2);
    [safe] s=0 -> (s'=3);

    [fast_low] s=1 -> (s'=6);
    [fast_high] s=2 -> (s'=6);

    [safe_first] s=3 -> (s'=4);
    [safe_second] s=4 -> 0.5 : (s'=5) + 0.5 : (s'=6);
    [safe_tail] s=5 -> (s'=6);

    [done] s=6 -> (s'=6);
endmodule

rewards "cost"
    [fast] true : 0;
    [safe] true : 0;
    [fast_low] true : 2;
    [fast_high] true : 30;
    [safe_first] true : 3;
    [safe_second] true : 3;
    [safe_tail] true : 1;
    [done] true : 0;
endrewards

label "target" = s=6;
